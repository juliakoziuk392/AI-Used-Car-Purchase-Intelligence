# Postgres (docker compose + API + міграції)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=carintel
# DB_HOST=localhost
# true для керованих Postgres (Supabase, Neon), які приймають лише TLS.
# DB_SSL=false

# Порт Postgres на хості. Якщо 5432 вже зайнятий локальним Postgres
# або іншим контейнером — постав інший, напр. 5433.
DB_EXTERNAL_PORT=5432

# API
# NODE_ENV=production вмикає суворі перевірки конфігу й вимикає Swagger.
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5174
# Щонайменше 32 символи. У продакшені стандартне значення не приймається:
# згенеруй, напр., `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# true за reverse proxy (nginx, Caddy), щоб rate limit бачив IP клієнта.
TRUST_PROXY=false
# Swagger UI на /docs. За замовчуванням увімкнено всюди, крім NODE_ENV=production.
# SWAGGER_ENABLED=true
# Тека зібраного фронту: якщо задано, API віддає його сам, а маршрути API — під /api (як на Render).
# WEB_DIST_DIR=../web/dist
# Скільки аналізів може запустити один користувач за добу.
ANALYSES_DAILY_LIMIT=20

# Redis / BullMQ (етап 2)
REDIS_URL=redis://localhost:6379

# S3-сховище 3D-моделей: локально MinIO з docker-compose, у продакшені — будь-яке S3
# (AWS S3, Cloudflare R2, Backblaze B2…). Бакет API створює сам, якщо його нема.
# Для AWS S3 прибери S3_ENDPOINT і задай S3_REGION; S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=carintel-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# AI-аналіз оголошення: gemini (безкоштовний ключ) або claude (платний API).
# Без LLM_PROVIDER береться той провайдер, для якого задано ключ; без ключів — демо-звіти.
LLM_PROVIDER=gemini
# Gemini: безкоштовний ключ на https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Claude: ключ на https://platform.claude.com (потрібне поповнення балансу)
LLM_API_KEY=
# Скільки фото оголошення надсилати в AI (більше фото — точніше, але дорожче).
LLM_MAX_PHOTOS=40

# 3D-модель авто з фото (TRELLIS на Hugging Face, безкоштовно з денною квотою GPU).
# HF_TOKEN безкоштовного акаунта huggingface.co збільшує квоту; без нього теж працює.
HF_TOKEN=
TRELLIS_SPACE=trellis-community/TRELLIS
