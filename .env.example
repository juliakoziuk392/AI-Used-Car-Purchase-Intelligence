# Postgres (docker compose + API + міграції)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=carintel
# DB_HOST=localhost

# Порт Postgres на хості. Якщо 5432 вже зайнятий локальним Postgres
# або іншим контейнером — постав інший, напр. 5433.
DB_EXTERNAL_PORT=5432

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5174
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Redis / BullMQ (етап 2)
REDIS_URL=redis://localhost:6379

# S3 / MinIO (етап 2)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=carintel-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# LLM (етап 2+)
LLM_API_KEY=
# Скільки фото оголошення надсилати в AI (більше фото — точніше, але дорожче).
LLM_MAX_PHOTOS=40

# 3D-модель авто з фото (TRELLIS на Hugging Face, безкоштовно з денною квотою GPU).
# HF_TOKEN безкоштовного акаунта huggingface.co збільшує квоту; без нього теж працює.
HF_TOKEN=
TRELLIS_SPACE=trellis-community/TRELLIS
